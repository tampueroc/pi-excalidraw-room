{
  "name": "pi-excalidraw-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Pi extension that joins a live Excalidraw collaboration room",
  "keywords": [
    "pi-package",
    "excalidraw",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test src/*.test.ts src/**/*.test.ts tests/interop.test.ts",
    "test:e2e": "EXCALIDRAW_E2E=1 node --test --test-concurrency=1 tests/e2e-local.test.ts tests/e2e-write.test.ts tests/e2e-persist.test.ts",
    "load": "node scripts/check-load.cjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "fractional-indexing": "^4.0.0",
    "jiti": "^2.7.0",
    "jsdom": "^25.0.1",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.3",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  }
}
